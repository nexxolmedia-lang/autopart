# ─────────────────────────────────────────────────────────────────────────────
# AutoPart (اتوپارت) — environment variables
# Copy to `.env` for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (PostgreSQL 15+).
# Local default matches `npm run db:local` (embedded PostgreSQL on port 54329).
DATABASE_URL="postgresql://autopart:autopart@localhost:54329/autopart_dev?schema=public"

# Separate database for integration tests. Its name MUST contain "test":
# the test runner wipes it before every test file.
TEST_DATABASE_URL="postgresql://autopart:autopart@localhost:54329/autopart_test?schema=public"

# Optional: database for Playwright e2e runs (name must contain "e2e").
# Defaults to DATABASE_URL with the database name replaced by "autopart_e2e".
# E2E_DATABASE_URL="postgresql://autopart:autopart@localhost:54329/autopart_e2e?schema=public"

# Public base URL of the site (used for metadata, canonical URLs and emails).
APP_URL="http://localhost:3000"

# Password given to every demo account by `npm run db:seed`.
# Required when seeding a production build (see ALLOW_DEMO_SEED).
SEED_DEMO_PASSWORD="change-me-Demo-2026"

# Shows the demo-account panel on /login. Only for local/showcase deployments
# that contain demo data — NEVER enable on a deployment with real data.
DEMO_MODE="false"

# The seed script wipes all data. It refuses to run when NODE_ENV=production
# unless this is "true" (for disposable demo environments only).
# ALLOW_DEMO_SEED="false"

# Session cookies are `Secure` + `__Host-` prefixed in production. Set to
# "false" only when serving a production build over plain HTTP on a private
# network for testing (not recommended).
# COOKIE_SECURE="true"

# Set to "standalone" to produce a self-contained server in .next/standalone
# (used by the Dockerfile).
# NEXT_OUTPUT="standalone"
